<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType><Platform>x64</Platform><InstallerPlatform>x64</InstallerPlatform>
    <OutputName>AudioEnforcer-$(VersionPrefix)-x64</OutputName>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(VersionPrefix)</DefineConstants>
  </PropertyGroup>
</Project>
