<Window x:Class="AudioEnforcer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Enforcer" Width="610" Height="430"
        MinWidth="540" MinHeight="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Audio Enforcer" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="Choose the microphone and speakers or headset Windows should use. Audio Enforcer reapplies them when you sign in and when devices reconnect." />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,17">
            <TextBlock Text="Default playback device" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="PlaybackDevices" DisplayMemberPath="Name" SelectedValuePath="Id" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,17">
            <TextBlock Text="Default recording device" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="RecordingDevices" DisplayMemberPath="Name" SelectedValuePath="Id" />
        </StackPanel>
        <Border Grid.Row="3" x:Name="StatusBorder" Background="#FFF1F5F9" CornerRadius="5" Padding="12" Margin="0,0,0,14">
            <TextBlock x:Name="StatusText" Text="Select both devices, then choose Apply now." TextWrapping="Wrap" />
        </Border>
        <TextBlock Grid.Row="4" Foreground="#FF555555" TextWrapping="Wrap" Text="Note: Some applications remember their own input or output device. Changing the Windows default may not override an app-specific selection." />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Open Windows sound settings" MinWidth="190" Margin="0,0,10,0" Click="OpenSettings_Click" />
            <Button Content="Apply now" FontWeight="SemiBold" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
