# VERSION, SHA256, and INSTALLER_URL are replaced by scripts/New-WinGetManifest.ps1.
PackageIdentifier: BryanCole.AudioEnforcer
PackageVersion: VERSION
InstallerType: wix
Scope: user
Installers:
  - Architecture: x64
    InstallerUrl: INSTALLER_URL
    InstallerSha256: SHA256
    InstallerSwitches:
      Silent: /qn
      SilentWithProgress: /passive
ManifestType: installer
ManifestVersion: 1.9.0
